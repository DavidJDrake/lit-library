{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node18",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "bin",
    "lib",
    "lambda",
    "test"
  ],
  "exclude": [
    "node_modules",
    "cdk.out"
  ]
}
